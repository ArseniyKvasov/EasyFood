# --- Приложение ---
PORT=3000
NODE_ENV=production
# Порты двух слотов приложения на хосте: деплой поднимает свободный слот и
# переключает nginx, поэтому запросы не прерываются.
# 127.0.0.1 — доступ только через nginx (рекомендуется для сервера).
APP_PORT=8080
APP_PORT_GREEN=8081
APP_BIND=127.0.0.1
# Публичный адрес сайта: по нему deploy/production.sh проверяет выкладку.
SITE_URL=https://example.com
# Конфиг nginx, в котором скрипт меняет порт. По умолчанию
# /etc/nginx/sites-available/<домен из SITE_URL>; если файла нет, скрипт
# создаёт его из шаблона deploy/nginx при первом деплое.
# NGINX_SITE_FILE=/etc/nginx/sites-available/food.fastclass.ru
# Сервер с SNI-прокси на 443 (stream-слой завершает TLS по имени): 1 - брать
# шаблон food.fastclass.ru.sni.conf. По умолчанию 0.
# NGINX_SNI=0
# Путь к stream-конфигу: скрипт предупредит, если в его map нет строки для
# вашего домена (без неё соединение получит чужой сертификат).
# NGINX_STREAM_CONF=/etc/nginx/stream-xray.conf

# --- Сертификат Let's Encrypt ---
# Если в /etc/letsencrypt/live/<домен из SITE_URL>/ нет сертификата, деплой
# попробует выпустить его через certbot (webroot, нужен доступный снаружи
# порт 80) и затем включит HTTPS-конфиг nginx.
# Почта для уведомлений Let's Encrypt (пусто — регистрация без почты).
# LE_EMAIL=admin@example.com
# Каталог ACME-проверок: nginx отдаёт из него /.well-known/acme-challenge/
# (в шаблонах deploy/nginx это уже настроено).
# ACME_WEBROOT=/var/www/certbot
# Автоматический выпуск: 1 — да, 0 — нет (то же, что флаг --no-ssl).
# AUTO_SSL=1
# Поставить certbot через apt, если его нет: 1 — да.
# AUTO_SSL_INSTALL=0
# Тестовый сертификат Let's Encrypt staging: 1 — да.
# LE_STAGING=0
# За сколько дней до истечения продлевать сертификат.
# CERT_RENEW_DAYS=30
# Нестандартный каталог Let's Encrypt (например, для тестов).
# CERTBOT_LIVE_DIR=/etc/letsencrypt/live
# Разрешённый источник для CORS (через запятую). Пусто — CORS выключен.
CORS_ORIGIN=

# --- Админка (/app/admin) ---
# Логины Яндекс ID через запятую: эти пользователи при первом заходе
# автоматически становятся суперадминами (дальше роли раздаются из интерфейса).
# Пример: ADMIN_LOGINS=vasya,nina
ADMIN_LOGINS=

# --- Rate limits (запросов в минуту) ---
# Общий лимит всех /api/* с одного IP; ИИ и админка лимитируются строже
# по пользователю. 0 — выключить все лимиты (только для отладки).
RATE_LIMIT_ENABLED=1
RATE_LIMIT_GENERAL_PER_MIN=300
RATE_LIMIT_AI_PER_MIN=30
RATE_LIMIT_ADMIN_PER_MIN=120

# --- Подписки Plus через Т-Банк ---
# Без TERMINAL_KEY/PASSWORD checkout отвечает 503, вебхуки не принимаются.
# Тестовый терминал: lk.tbank.ru → Магазин → тестовый режим.
TBANK_TERMINAL_KEY=
TBANK_PASSWORD=
# Боевой: https://securepay.tinkoff.ru/v2 (или securepay.tbank.ru/v2)
TBANK_BASE_URL=https://securepay.tinkoff.ru/v2
# Куда вернуть после оплаты. Пусто — без редиректа от банка.
TBANK_SUCCESS_URL=https://example.com/app/?payment=success
TBANK_FAIL_URL=https://example.com/app/?payment=fail
# Куда банк шлёт вебхуки. Пусто — SITE_URL + /api/billing/notify.
TBANK_NOTIFICATION_URL=
# Налогообложение для чеков 54-ФЗ (УСН доход: usn_income).
TBANK_TAXATION=usn_income
TBANK_COMPANY_EMAIL=
# Цены в копейках.
BILLING_MONTH_PRICE=29900
BILLING_YEAR_PRICE=199000
# Предупреждение о списании за N дней, тик планировщика (мин), паузы dunning (часы).
BILLING_PRECHARGE_DAYS=3
BILLING_TICK_MINUTES=60
BILLING_DUNNING_HOURS=24,72

# --- Письма (чеки, предуведомления, возвраты) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=BiteBalance <noreply@example.com>

# --- Деплой: место на диске и сертификаты ---
# Порог заполнения диска (%). Выше — один проход чистки, потом стоп деплоя.
MEMORY_GUARD_THRESHOLD_PERCENT=90
# Где искать дополнительные корневые сертификаты на сервере (в git не входят).
# Свои сертификаты кладите сюда, а не в certs/russian/, чтобы не мешать git pull.
# BITEBALANCE_RUSSIAN_CA_DIR=/etc/bitebalance/russian-ca

# --- Вход через Яндекс ID (обязательно) ---
# 1. https://oauth.yandex.ru → «Создать приложение» → платформа «Веб-сервисы».
# 2. Redirect URI: https://<домен>/api/auth/yandex/callback
# 3. Права: «Доступ к адресу электронной почты» и «Доступ к логину, имени и
#    фамилии, полу» — этого хватает для имени, фамилии и почты.
#    Имя и фамилия идут одним правом вместе с логином и полом.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# Адрес возврата. Пусто — собирается из заголовков запроса (удобно локально).
YANDEX_REDIRECT_URI=
# Права, которые запрашиваем. Пусто — только id и логин.
YANDEX_SCOPE=login:info login:email

# --- База данных ---
# Установка, перенесённая с EasyFood, оставляет здесь прежние значения:
# роль и база уже созданы в томе, менять их без переноса данных нельзя.
POSTGRES_USER=bitebalance
POSTGRES_PASSWORD=bitebalance
POSTGRES_DB=bitebalance

# --- Perek (основная база продуктов и КБЖУ) ---
# Ключ выдаётся в кабинете https://app.perek.us/developers после входа.
# Пока ключа нет, поиск работает только по своей базе, а штрихкоды —
# через резервный Open Food Facts.
PEREK_API_KEY=
PEREK_BASE_URL=https://perek.us/api/v1/foods
# Бесплатный тариф Perek — 20 запросов в минуту. Держим чуть ниже лимита.
PEREK_REQUESTS_PER_MINUTE=18
# Сколько дней не ходить в Perek за уже обогащённым запросом.
PEREK_QUERY_TTL_DAYS=30
# Для запросов без результатов — короче, чтобы подхватить новые продукты.
PEREK_EMPTY_QUERY_TTL_DAYS=7
# Фоновая синхронизация каталога по реальному спросу.
PEREK_SYNC_BATCH=3
PEREK_SYNC_INTERVAL_MINUTES=15

# --- Open Food Facts (резервный поиск по штрихкоду) ---
# Выключить, если нет доступа к интернету из контейнера.
OPEN_FOOD_FACTS_ENABLED=true

# --- Распознавание блюд по фото (необязательно) ---
# Любой OpenAI-совместимый vision-эндпоинт. Если ключа нет — функция
# отключается, а интерфейс честно предлагает заполнить продукт вручную.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Уровень размышления для reasoning-моделей (OpenRouter: reasoning.effort).
# low | minimal | medium | high | xhigh | max | none. Пусто — не отправлять.
OPENAI_REASONING_EFFORT=
# Температура. Пустое значение — поле не отправляется (нужно моделям,
# которые принимают только temperature=1, например Claude Haiku 5.5).
OPENAI_TEMPERATURE=0.2
# Потолок ответа; thinking-токены считаются в тот же лимит. Пусто — не отправлять.
OPENAI_MAX_TOKENS=
# json_object (по умолчанию) или json_schema (нативные structured outputs).
OPENAI_RESPONSE_FORMAT=json_object

# --- Напоминания (Web Push) ---
# Ключи VAPID. Сгенерировать: npm run vapid
# Без ключей напоминания выключены, остальное приложение работает.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Контакт администратора для push-сервисов: mailto:... или https://...
VAPID_SUBJECT=mailto:admin@example.com

# --- Бэкапы базы ---
# Дампы (pg_dump в gzip) кладутся в локальную папку — внешнего хранилища нет.
# В Docker путь монтируется томом backups.
BACKUP_DIR=data/backups
# Сколько дней хранить дампы.
BACKUP_KEEP_DAYS=14

# --- Обслуживание ---
# Сколько дней хранить историю дневника, дальше записи удаляются.
HISTORY_RETENTION_DAYS=60
# Как часто делать бэкап базы и чистить историю, часов.
BACKUP_INTERVAL_HOURS=24
RETENTION_INTERVAL_HOURS=6

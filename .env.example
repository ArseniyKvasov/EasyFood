# --- Приложение ---
PORT=3000
NODE_ENV=production
# Порт и интерфейс, на которых приложение доступно на хосте.
# 127.0.0.1 — доступ только через nginx (рекомендуется для сервера).
APP_PORT=8080
APP_BIND=127.0.0.1
# Разрешённый источник для CORS (через запятую). Пусто — CORS выключен.
CORS_ORIGIN=

# --- База данных ---
POSTGRES_USER=easyfood
POSTGRES_PASSWORD=easyfood
POSTGRES_DB=easyfood

# --- Open Food Facts (поиск и штрихкоды) ---
# Выключить, если нет доступа к интернету из контейнера.
OPEN_FOOD_FACTS_ENABLED=true

# --- Распознавание блюд по фото (необязательно) ---
# Любой OpenAI-совместимый vision-эндпоинт. Если ключа нет — функция
# отключается, а интерфейс честно предлагает заполнить продукт вручную.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Уровень размышления для reasoning-моделей (OpenRouter: reasoning.effort).
# low | minimal | medium | high | xhigh | max | none. Пусто — не отправлять.
OPENAI_REASONING_EFFORT=
# Температура. Пустое значение — поле не отправляется (нужно моделям,
# которые принимают только temperature=1, например Claude Haiku 5.5).
OPENAI_TEMPERATURE=0.2
# Потолок ответа; thinking-токены считаются в тот же лимит. Пусто — не отправлять.
OPENAI_MAX_TOKENS=
# json_object (по умолчанию) или json_schema (нативные structured outputs).
OPENAI_RESPONSE_FORMAT=json_object

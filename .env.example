# --- Приложение ---
PORT=3000
NODE_ENV=production
# Порт и интерфейс, на которых приложение доступно на хосте.
# 127.0.0.1 — доступ только через nginx (рекомендуется для сервера).
APP_PORT=8080
APP_BIND=127.0.0.1
# Разрешённый источник для CORS (через запятую). Пусто — CORS выключен.
CORS_ORIGIN=

# --- База данных ---
POSTGRES_USER=easyfood
POSTGRES_PASSWORD=easyfood
POSTGRES_DB=easyfood

# --- Open Food Facts (поиск и штрихкоды) ---
# Выключить, если нет доступа к интернету из контейнера.
OPEN_FOOD_FACTS_ENABLED=true

# --- Nutriapix (основной источник каталога) ---
# Ключ выдаётся на https://nutriapix.ru. Пока пусто — поиск работает
# на своей базе и Open Food Facts.
NUTRIAPIX_API_KEY=
NUTRIAPIX_BASE_URL=https://nutriapix.ru/api/v1
# Лимиты тестового токена: /food — 1000 запросов в месяц, поиск — без ограничений.
NUTRIAPIX_MONTHLY_BUDGET=1000
# Сколько запросов из лимита можно тратить на предзагрузку каталога,
# остальное остаётся пользователям.
NUTRIAPIX_BACKFILL_BUDGET=700
# Сколько продуктов докачивать за один проход и как часто запускать.
NUTRIAPIX_BACKFILL_BATCH=2
NUTRIAPIX_BACKFILL_INTERVAL_HOURS=2

# --- Распознавание блюд по фото (необязательно) ---
# Любой OpenAI-совместимый vision-эндпоинт. Если ключа нет — функция
# отключается, а интерфейс честно предлагает заполнить продукт вручную.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Уровень размышления для reasoning-моделей (OpenRouter: reasoning.effort).
# low | minimal | medium | high | xhigh | max | none. Пусто — не отправлять.
OPENAI_REASONING_EFFORT=
# Температура. Пустое значение — поле не отправляется (нужно моделям,
# которые принимают только temperature=1, например Claude Haiku 5.5).
OPENAI_TEMPERATURE=0.2
# Потолок ответа; thinking-токены считаются в тот же лимит. Пусто — не отправлять.
OPENAI_MAX_TOKENS=
# json_object (по умолчанию) или json_schema (нативные structured outputs).
OPENAI_RESPONSE_FORMAT=json_object

# --- S3: фото пользователей и бэкапы базы ---
# Пока переменные не заданы, фото уходят на сервер как раньше, а бэкапы
# не делаются. После настройки фото грузится в бакет напрямую из браузера,
# и сервер приложения байты картинки не видит.
S3_BUCKET=
# Эндпоинт. Пусто — стандартный AWS S3.
# Yandex Cloud: https://storage.yandexcloud.net
# MinIO: http://minio:9000 (тогда S3_FORCE_PATH_STYLE=true)
S3_ENDPOINT_URL=
S3_REGION_NAME=ru-central1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# MinIO и часть совместимых хранилищ требуют адрес вида bucket/host.
S3_FORCE_PATH_STYLE=false
# Префиксы внутри бакета.
S3_LOCATION=uploads
S3_BACKUP_LOCATION=backups
# Сколько живёт подписанная ссылка на фото, секунд.
S3_QUERYSTRING_EXPIRE=900
# Сколько дней хранить бэкапы базы.
S3_BACKUP_KEEP_DAYS=14
# Сколько часов может жить загруженная картинка: после создания продукта
# она удаляется сразу, а всё, что осталось, чистится по этому сроку.
S3_UPLOAD_KEEP_HOURS=24

# --- Обслуживание ---
# Сколько дней хранить историю дневника, дальше записи удаляются.
HISTORY_RETENTION_DAYS=60
# Как часто делать бэкап базы и чистить историю, часов.
BACKUP_INTERVAL_HOURS=24
RETENTION_INTERVAL_HOURS=6
# Как часто удалять из S3 старые картинки, часов. Чистка идёт с запасом,
# чтобы картинка не пережила S3_UPLOAD_KEEP_HOURS.
UPLOAD_CLEANUP_INTERVAL_HOURS=1
